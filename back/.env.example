# Origens exatas permitidas, separadas por vírgula (sem barra final ou curinga).
# Remova o domínio ngrok quando ele deixar de ser usado.
APP_ORIGIN=http://localhost:3000,https://defendant-dragging-dreadlock.ngrok-free.dev
# Módulo auth está inativo. Se reativado, configure sua URL única explicitamente.
# BETTER_AUTH_URL=https://fila.exemplo.com
# Gere um segredo aleatório de pelo menos 32 caracteres. Nunca versione o valor real.
BETTER_AUTH_SECRET=
# Caminho estável relativo ao diretório back; padrão: back/data/testafila.sqlite
# DATABASE_PATH=./data/testafila.sqlite
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
